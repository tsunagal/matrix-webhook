# Matrix Webhook Environment Variables
MATRIX_URL=http://host.docker.internal:8008
SERVER_NAME=localhost
BOT_LOCALPART=webhook_bot
# The as_token of the appservice registration
AS_TOKEN=REPLACE_WITH_RANDOM_AS_TOKEN
# Where the bot keeps its encryption keys (/data in Docker)
CRYPTO_DB_DIR=/data
# The bot's recovery key from /data/recovery_key.txt, written without spaces or quotes
RECOVERY_KEY=
# Optional: key used to encrypt the stored Olm account
PICKLE_KEY=matrix-webhook
